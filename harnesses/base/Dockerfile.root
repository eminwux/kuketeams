ARG REGISTRY=ghcr.io/eminwux/kuketeams
ARG TAG=latest
FROM ${REGISTRY}/base:${TAG}

ENV DEBIAN_FRONTEND=noninteractive

# Extra packages the root variants need: iptables for in-cell firewalling,
# sudo for selective drop-to-user operations, and the Docker apt stack so
# docker-in-cell flows (build/run) work against a bind-mounted socket or a
# nested daemon.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        iptables \
        sudo \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
 && chmod a+r /etc/apt/keyrings/docker.asc \
 && printf 'Types: deb\nURIs: https://download.docker.com/linux/debian\nSuites: %s\nComponents: stable\nArchitectures: %s\nSigned-By: /etc/apt/keyrings/docker.asc\n' \
        "$(. /etc/os-release && echo "$VERSION_CODENAME")" \
        "$(dpkg --print-architecture)" \
        > /etc/apt/sources.list.d/docker.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin \
 && rm -rf /var/lib/apt/lists/*

# A `user` account still exists in root cells so files dropped to /home/user
# can carry sensible ownership when a leaf drops privilege.
RUN useradd --create-home --home-dir /home/user --shell /bin/bash user \
 && usermod --home /home/user root

ENV HOME=/home/user
USER root
WORKDIR /home/user

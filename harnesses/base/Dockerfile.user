ARG REGISTRY=ghcr.io/eminwux/kuketeams
ARG TAG=latest
FROM ${REGISTRY}/base:${TAG}

ENV DEBIAN_FRONTEND=noninteractive

# gettext-base ships envsubst, used by render/install shell glue. Only the
# non-root variants need it (root variants run their own apt step downstream
# and historically have not carried it).
RUN apt-get update \
 && apt-get install -y --no-install-recommends gettext-base \
 && rm -rf /var/lib/apt/lists/*

# Non-root cells run as the unprivileged `claude` user, in the `kukeon` group
# so the bind-mounted /run/kukeon/kukeond.sock is dial-able without sudo.
RUN useradd --create-home --shell /bin/bash claude \
 && groupadd -g 988 kukeon \
 && usermod -aG kukeon claude

USER claude
WORKDIR /home/claude

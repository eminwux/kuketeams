ARG REGISTRY=ghcr.io/eminwux/kuketeams
ARG IMAGE_PREFIX=ghcr.io/eminwux/kuketeams/
ARG TAG=latest
FROM ${IMAGE_PREFIX}base-root:${TAG}

ARG CLAUDE_CODE_VERSION=latest

# Native install — runs as root, lands at /home/user/.local/bin/claude (root cells
# resolve $HOME=/home/user). Bakes the standalone binary into the image so
# installMethod=native is satisfied without a per-cell re-download. ~/.local is
# image state (not a bind-mount), so it persists.
ENV PATH=/home/user/.local/bin:$PATH

RUN curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}" \
 && echo 'export PATH=$HOME/.local/bin:$PATH' >> /home/user/.bashrc \
 && rm -f $HOME/.claude.json
# Drop the default ~/.claude.json the native install bakes in: every profile's
# onInit seeds login state via `[ -f ~/.claude.json ] || cp .claude.json.seed`,
# and a baked-in file would short-circuit that guard and skip the seed copy.

COPY Makefile.start /opt/kuketeams/harness/Makefile.start
